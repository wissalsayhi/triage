# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=

# GitHub token for the issues API. A classic token with public_repo scope is
# enough; without one you are limited to 60 requests/hour.
GITHUB_TOKEN=

# The public repository to triage issues from, as owner/name
TARGET_REPO=n8n-io/n8n

# Predictions below this confidence go to the review queue instead of being
# written as fact. Week 4 decides this number — and the README says why.
CONFIDENCE_THRESHOLD=0.75
